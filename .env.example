# Frontend build-time configuration.
# EVERY VITE_* VARIABLE IS PUBLIC: it is embedded in the JavaScript sent to browsers.
# Never put API keys, ERPNext credentials, database URLs or other secrets here.

# Same-origin API path. Keep /api: Vercel proxies /api/* to the Render backend (vercel.json),
# which keeps sign-in cookies first-party. Absolute URLs are rejected by the build.
VITE_API_BASE_URL=/api

# Display name used in the UI.
VITE_APP_NAME=Agrismart

# Support contact shown on the site (public information). Optional: when unset, the site shows
# the official AGRI SMART FARM SOLUTIONS LLP contact details built into Header.tsx.
VITE_SUPPORT_EMAIL=agrismartfarmsolutionsllp@gmail.com
VITE_SUPPORT_PHONE=+91 93739 47000

# NOT a VITE_ variable and NOT set here: ORIGIN_SECRET is a server-side Vercel Environment
# Variable (Project Settings > Environment Variables, type "Sensitive"). vercel.json injects it
# as a request header on proxied /api calls; it is never part of the build or the bundle.
